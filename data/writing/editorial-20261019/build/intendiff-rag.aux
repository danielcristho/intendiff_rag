\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Perbandingan hasil dengan penelitian sebelumnya, dalam persen. Semua model IntentDiff-RAG menggunakan DIFF+I+MB pada 129 MAL dan 1.868 TYP. Dataset antarpenelitian berbeda, sehingga tabel ini merupakan perbandingan deskriptif. Tanda * menunjukkan akurasi yang dihitung dari jumlah prediksi benar pada paper sumber.}}{9}{table.5}\protected@file@percent }
\newlabel{tab:cross-study}{{5}{9}{Perbandingan hasil dengan penelitian sebelumnya, dalam persen. Semua model IntentDiff-RAG menggunakan DIFF+I+MB pada 129 MAL dan 1.868 TYP. Dataset antarpenelitian berbeda, sehingga tabel ini merupakan perbandingan deskriptif. Tanda * menunjukkan akurasi yang dihitung dari jumlah prediksi benar pada paper sumber}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Kemampuan dasar tanpa contoh rujukan: smart-diff saja (DIFF) dan smart-diff dengan intent (DIFF+I). TP adalah jumlah MAL yang terdeteksi dari 129 sampel; FP adalah jumlah alarm palsu dari 1.868 TYP. TPR dan FPR disajikan sebagai persentase. Respons invalid dianggap benign.}}{9}{table.6}\protected@file@percent }
\newlabel{tab:main}{{6}{9}{Kemampuan dasar tanpa contoh rujukan: smart-diff saja (DIFF) dan smart-diff dengan intent (DIFF+I). TP adalah jumlah MAL yang terdeteksi dari 129 sampel; FP adalah jumlah alarm palsu dari 1.868 TYP. TPR dan FPR disajikan sebagai persentase. Respons invalid dianggap benign}{table.6}{}}
