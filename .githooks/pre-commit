#!/bin/sh

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FORBIDDEN='^(\.env$|data/users\.json$|data/(wyss|typ|hn|datadog|tarballs)/)|\.pdf$|^scratchpad/'
if BAD=$(echo "$STAGED" | grep -E "$FORBIDDEN"); then
  echo "✗ these paths must not be committed:"
  echo "$BAD" | sed 's/^/  /'
  exit 1
fi
echo "✓ paths"

ADDED=$(git diff --cached -U0 --diff-filter=ACMR -- . ':!*.lock' ':!data/' | grep '^+[^+]' || true)
LEAK=$(echo "$ADDED" \
  | grep -nE '([0-9]{1,3}\.){3}[0-9]{1,3}|/home/[a-z]|/Users/[A-Za-z]' \
  | grep -vE '(127\.0\.0\.1|0\.0\.0\.0|192\.0\.2\.[0-9]+)' || true)
if [ -n "$LEAK" ]; then
  echo "✗ staged lines look like an IP address or home path:"
  echo "$LEAK" | cut -c1-120 | sed 's/^/  /'
  echo "  use <host-ip-address>, <gpu-host> or a repo-relative path; bypass with --no-verify if it is a false positive"
  exit 1
fi
echo "✓ no internal identifiers"

if echo "$STAGED" | grep -q '^backend/'; then
  cargo fmt --manifest-path backend/Cargo.toml --check > /dev/null \
    || { echo "✗ rustfmt: run cargo fmt --manifest-path backend/Cargo.toml"; exit 1; }
  echo "✓ rustfmt"
fi
