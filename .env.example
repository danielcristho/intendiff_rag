# Interface the published ports bind to. 0.0.0.0 reaches every interface; the
# other containers on the GPU host bind to the VPN address 192.0.2.11
# instead, which keeps them off the LAN. The audit UI has no authentication, so
# whoever can reach the port can read and change labels.
BIND_ADDR=0.0.0.0

# Published ports. The GPU host already uses 8000 (production-service), 8080, 8081,
# 5433, 9400 and 18888 — run `docker ps` before reusing any port here.
BACKEND_PORT=8100
FRONTEND_PORT=5174
VLLM_PORT=8101

# Host user the backend container runs as, so writes to the bind-mounted
# ./data land with your ownership. Check with `id -u` and `id -g`.
APP_UID=1000
APP_GID=1000

# Model served by the vllm service.
#
# Default is Qwen2.5-Coder-3B-Instruct because D44 measured Qwen3-4B at 11,95
# GiB against a 12 GiB card: it does not fit at 32768 context. Switch to
# Qwen3-4B-Instruct-2507 only on a GPU with at least 16 GB (D45, opsi A).
MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# Pin before Stage 1: methodology §9.2 requires the vLLM version to be recorded.
VLLM_IMAGE=vllm/vllm-openai:latest

# Fraction of TOTAL GPU memory vLLM reserves at startup. The GPU host also runs
# production-service on the same card, so check `nvidia-smi` for what is actually
# free and set this below it. 0.45 of 12 GiB = 5.4 GiB, which is not enough for
# Qwen2.5-Coder-3B (6.9 GiB) — raise it only once the card is free.
VLLM_GPU_UTIL=0.45

# Needed only for gated models.
HF_TOKEN=
