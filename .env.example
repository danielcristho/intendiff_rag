# Intentdiff RAG configuration file

#! Interface the published ports bind to. 0.0.0.0 reaches every interface
BIND_ADDR=0.0.0.0

#! Published ports.
BACKEND_PORT=8100
FRONTEND_PORT=5174
VLLM_PORT=8101

# Host user the backend container runs as, so writes to the bind-mounted
# ./data land with your ownership. Check with `id -u` and `id -g`.
APP_UID=1000
APP_GID=1000

#! Model served by the vllm service.
MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

#! vLLM config
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_GPU_UTIL=0.80

#! Huggingface config, if needed
HF_TOKEN=
