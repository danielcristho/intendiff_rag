# The nginx image fills ${BACKEND_PORT} from the environment at start-up.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # resolver looks "backend" up per request, so a recreated backend container is found again.
    resolver 127.0.0.11 valid=10s;
    set $backend http://backend:${BACKEND_PORT};

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        # Replaces any client-sent value so a client cannot pick its own rate-limit key.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /health {
        proxy_pass $backend;
    }
}
