FROM node:26-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS build

WORKDIR /web

COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Node 25 images no longer ship corepack; install the pnpm that package.json pins.
RUN npm install -g "$(node -p "require('./package.json').packageManager")"

RUN pnpm install --frozen-lockfile

COPY frontend ./

RUN pnpm build

FROM nginx:1.31-alpine@sha256:fb4658584bd9a916ffb6f6e365f97c25cfdb2923801f551ea08356e695f14ff7

COPY deployments/docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 80
